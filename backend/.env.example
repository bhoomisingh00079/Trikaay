
# ===== CRITICAL: Must be set before running =====

# MongoDB Connection (REQUIRED)
# Format: mongodb+srv://user:password@cluster.mongodb.net/trikaay?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/trikaay
MONGO_URI=

# JWT Authentication Secrets (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encryption Key (REQUIRED - MUST be exactly 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=

# ===== Server Configuration =====
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:3000

# ===== Google Sheets Integration =====
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ===== Email Configuration (Gmail) =====
EMAIL_USER=
EMAIL_PASSWORD=

# ===== Optional Settings =====
SPREADSHEET_ID=
SHEET_NAME=Volunteer Registrations
NGO_NAME=Trikaay Care and Creation Association
AUTOMATION_ENABLED=true
AUTOMATION_MODE=webhook
AUTOMATION_WEBHOOK_TOKEN=
AUTOMATION_INTERVAL=60000
