# ===== CRITICAL: Must be set before running =====

# MongoDB Connection (REQUIRED)
# Example: mongodb+srv://user:password@cluster.mongodb.net/trikaay?retryWrites=true&w=majority
# Or for local: mongodb://localhost:27017/trikaay
MONGO_URI=

# JWT Authentication Secrets (REQUIRED - 64+ chars recommended)
# Generate secure random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_at_least_64_characters_long_please
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production_at_least_64_characters_long

# Encryption Key (REQUIRED - MUST be exactly 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=

# ===== Standard Configuration =====

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Google Sheets Integration
SPREADSHEET_ID=1rWOdgS8PeH9y1VgulAma_bACRpmhJE7HwrDex_-6llo
SHEET_NAME=Volunteer Registrations
# Note: Service account JSON file should be at backend/config/googleAuth.json

# Email Configuration (Gmail)
EMAIL_USER=
EMAIL_PASSWORD=
# Note: Use Gmail App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords

# NGO Information
NGO_NAME=Trikaay Care and Creation Association

# Automation Settings
AUTOMATION_ENABLED=true
AUTOMATION_MODE=webhook
AUTOMATION_INTERVAL=10000  # In milliseconds (10000 = 10 seconds)

GOOGLE_SERVICE_ACCOUNT_EMAIL=trickay@trickay.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID= 
# https://docs.google.com/spreadsheets/d/1rWOdgS8PeH9y1VgulAma_bACRpmhJE7HwrDex_-6llo/edit?usp=sharing
